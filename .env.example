DATABASE_URL=
BETTER_AUTH_SECRET=
NEXT_PUBLIC_VERCEL_APP_CLIENT_ID=
VERCEL_APP_CLIENT_SECRET=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Required: the owner's email. Always allowed to sign in.
HARPY_OWNER_EMAIL=

# Optional: more allowed emails, comma-separated.
HARPY_ALLOWED_EMAILS=

# Required: 32 random bytes, base64 (openssl rand -base64 32). Encrypts stored MCP tokens and OAuth state. Rotating it makes them unreadable.
SOCIAL_TOKEN_ENCRYPTION_KEY=

# Required for images and uploads (chat works without it): token for a public Vercel Blob store.
BLOB_READ_WRITE_TOKEN=

# Local development only: model access. Or use VERCEL_OIDC_TOKEN from `vercel env pull`.
AI_GATEWAY_API_KEY=

# Optional: override the app origin for a custom production domain.
BETTER_AUTH_URL=

# Optional: enable hosted Vercel Connect integrations.
SLACK_CONNECTOR=
LINEAR_CONNECTOR=
NOTION_CONNECTOR=
SENTRY_CONNECTOR=

# WhatsApp (see docs/whatsapp-setup.md). The first four must all be set or WhatsApp stays off.
# System user token with whatsapp_business_messaging and whatsapp_business_management, set to never expire.
WHATSAPP_ACCESS_TOKEN=
# App secret from the Meta app (App settings, Basic). Verifies webhook signatures.
WHATSAPP_APP_SECRET=
# Phone number ID of the sending number.
WHATSAPP_PHONE_NUMBER_ID=
# A random string you choose; enter the same one in Meta's webhook settings.
WHATSAPP_VERIFY_TOKEN=
# WhatsApp Business Account ID, for managing message templates.
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Your own number(s), digits only, comma-separated. These link to the owner on first contact.
HARPY_WHATSAPP_ALLOWED_NUMBERS=
# The number people message, digits only. Builds the wa.me link on the Channels page.
HARPY_WHATSAPP_NUMBER=

HARPY_EVAL_AS_OWNER=  # local evals only: set to 1 to run evals as the owner; ignored in production
