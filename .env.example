DATABASE_URL=
BETTER_AUTH_SECRET=
NEXT_PUBLIC_VERCEL_APP_CLIENT_ID=
VERCEL_APP_CLIENT_SECRET=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Required: the owner's email. Always allowed to sign in.
HARPY_OWNER_EMAIL=

# Optional: more allowed emails, comma-separated.
HARPY_ALLOWED_EMAILS=

# Required: 32 random bytes, base64 (openssl rand -base64 32). Encrypts stored MCP tokens and OAuth state. Rotating it makes them unreadable.
SOCIAL_TOKEN_ENCRYPTION_KEY=

# Required: token for a public Vercel Blob store that holds images.
BLOB_READ_WRITE_TOKEN=

# Local development only: model access. Or use VERCEL_OIDC_TOKEN from `vercel env pull`.
AI_GATEWAY_API_KEY=

# Optional: override the app origin for a custom production domain.
BETTER_AUTH_URL=

# Optional: enable hosted Vercel Connect integrations.
SLACK_CONNECTOR=
LINEAR_CONNECTOR=
NOTION_CONNECTOR=
SENTRY_CONNECTOR=
